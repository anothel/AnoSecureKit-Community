# Counts distinct demangled names on Itanium platforms and decorated names on
# MSVC. '+' allows compiler-generated constructor variants; '*' allows optional
# generated special members. Every actual export still needs an explicit rule.
function(anosecurekit_check_export_inventory symbols allowlist)
  list(REMOVE_DUPLICATES symbols)
  file(STRINGS "${allowlist}" rules)
  set(matched_symbols)
  foreach(rule IN LISTS rules)
    if(rule STREQUAL "" OR rule MATCHES "^#")
      continue()
    endif()
    string(FIND "${rule}" "|" separator)
    if(separator LESS 1)
      message(FATAL_ERROR "export inventory invalid rule: ${rule}")
    endif()
    string(SUBSTRING "${rule}" 0 ${separator} expected)
    math(EXPR regex_start "${separator} + 1")
    string(SUBSTRING "${rule}" ${regex_start} -1 regex)
    set(count 0)
    foreach(symbol IN LISTS symbols)
      if(symbol MATCHES "${regex}")
        list(FIND matched_symbols "${symbol}" already_matched)
        if(NOT already_matched EQUAL -1)
          message(FATAL_ERROR "export inventory overlapping rules for: ${symbol}")
        endif()
        math(EXPR count "${count} + 1")
        list(APPEND matched_symbols "${symbol}")
      endif()
    endforeach()
    if(expected STREQUAL "+")
      if(count LESS 1)
        message(FATAL_ERROR "export inventory missing required family: ${regex}")
      endif()
    elseif(NOT expected STREQUAL "*")
      if(NOT expected MATCHES "^[0-9]+$" OR NOT count EQUAL expected)
        message(FATAL_ERROR "export inventory expected ${expected}, found ${count}: ${regex}")
      endif()
    endif()
  endforeach()
  set(unexpected ${symbols})
  foreach(symbol IN LISTS matched_symbols)
    list(REMOVE_ITEM unexpected "${symbol}")
  endforeach()
  if(unexpected)
    list(JOIN unexpected "\n  " unexpected_text)
    message(FATAL_ERROR "export inventory unexpected symbols:\n  ${unexpected_text}")
  endif()
  list(LENGTH symbols actual_total)
  if(actual_total EQUAL 0)
    message(FATAL_ERROR "export inventory is empty")
  endif()
  message(STATUS "AnoSecureKit shared symbol allowlist passed: ${actual_total} unique public symbols")
endfunction()
